[Unit]
Description=HealthData-Valuator Backend
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/opt/HealthData-Valuator/backend
EnvironmentFile=/opt/HealthData-Valuator/backend/.env

# 使用虚拟环境的 uvicorn（把路径按你的实际环境修改）
ExecStart=/opt/HealthData-Valuator/backend/venv/bin/python -m uvicorn main:app --host 127.0.0.1 --port 8000 --workers 2

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target

